ZK_DEVICE_IP=192.168.18.201
ZK_DEVICE_PORT=4370
ATTENDANCE_SYNC_INTERVAL_MS=3000
ATTENDANCE_TIMEZONE_OFFSET_MINUTES=300
CONNECTOR_API_URL=https://your-vercel-domain.vercel.app/api/attendance/ingest
CONNECTOR_COMMANDS_URL=https://your-vercel-domain.vercel.app/api/attendance/commands
CONNECTOR_TOKEN=generate-a-long-random-secret
# Hostinger credentials are selected by mailbox domain prefix (for example,
# info@classtakerspro.com uses the CLASSTAKERSPRO variables). Keep secrets out of Git.
HOSTINGER_MAILBOX_DIGIFYITSOLUTION=info@digifyitsolution.com
HOSTINGER_API_TOKEN_DIGIFYITSOLUTION=replace_with_api_token
HOSTINGER_WEBHOOK_SECRET_DIGIFYITSOLUTION=replace_with_webhook_secret
HOSTINGER_WEBHOOK_ENCRYPTION_KEY_DIGIFYITSOLUTION=replace_with_generated_encryption_key

HOSTINGER_MAILBOX_CLASSTAKERSPRO=info@classtakerspro.com
