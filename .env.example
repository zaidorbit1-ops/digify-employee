HOSTINGER_WEBHOOK_SECRET_CLASSTAKERSPRO=replace_with_webhook_secret
HOSTINGER_WEBHOOK_ENCRYPTION_KEY_CLASSTAKERSPRO=replace_with_generated_encryption_key

