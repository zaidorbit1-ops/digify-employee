ZK_DEVICE_IP=192.168.18.201
ZK_DEVICE_PORT=4370
ATTENDANCE_SYNC_INTERVAL_MS=3000
ATTENDANCE_TIMEZONE_OFFSET_MINUTES=300
CONNECTOR_API_URL=https://your-vercel-domain.vercel.app/api/attendance/ingest
CONNECTOR_COMMANDS_URL=https://your-vercel-domain.vercel.app/api/attendance/commands
CONNECTOR_TOKEN=generate-a-long-random-secret
# Hostinger Mail API token with access to all required mailboxes.
HOSTINGER_API_TOKEN=replace_with_hostinger_api_token
# Default mailbox fallback. Additional mailboxes are added from CRM Webmail.
HOSTINGER_MAILBOX=info@digifyitsolution.com
# Optional fallback secret. Per-mailbox webhook secrets are stored encrypted by CRM.
HOSTINGER_WEBHOOK_SECRET=
# Public HTTPS endpoint used when CRM registers Hostinger webhooks.
HOSTINGER_WEBHOOK_URL=https://office.digifyitsolution.com/api/email/hostinger/webhook
# Generate locally with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
HOSTINGER_WEBHOOK_ENCRYPTION_KEY=replace_with_generated_random_key
